! Title: Cleanfeed-KO (AdGuard)
! Version: 2026.10.04
! Expires: 1 hour (update frequency)
! Homepage: https://github.com/jae-hyung-na/kr-cleanfeed-filters
! 
!  본 필터는 AdGuard 기준 작성 (uBlock Origin 버전에서 이식)
!  각 카테고리는 사이트별 기능/UI/광고 차단 목적
!  일부 필터는 사이트 구조 변경 시 오작동 가능
!  "js"      : 사이트 스크립트 대응 (충돌 가능성 있음)
! 
! youtube_cleanfeed
! 
! youtube "menu ui" remove
youtube.com###menu
! youtube "telemetry trim"
||youtube.com/api/stats/qoe$domain=youtube.com
||youtube.com/ptracking$domain=youtube.com
! youtube "home mixeds" hide
youtube.com##ytd-rich-item-renderer:has([href*="start_radio=1"])
! youtube "sidebar mixes" hide
youtube.com##ytd-compact-radio-renderer, :is(#related yt-lockup-view-model,ytd-compact-video-renderer):has([href*="&start_radio=1"])
! youtube "ambient mode" disalbe
youtube.com###cinematics.ytd-watch-flexy
youtube.com###cinematics,#shorts-cinematic-container
! youtube "channel watermark" disable
youtube.com##.ytp-watermark { disable: true; }
! youtube "comments" remove
youtube.com#$?#ytd-comments { remove: true; }
! 
