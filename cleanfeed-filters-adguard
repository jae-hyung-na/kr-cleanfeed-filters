! Title: Cleanfeed-KO (AdGuard)
! Version: 2026.09.27
! Expires: 1 hour (update frequency)
! Homepage: https://github.com/jae-hyung-na/kr-cleanfeed-filters
! 
!  본 필터는 AdGuard 기준 작성 (uBlock Origin 버전에서 이식)
!  각 카테고리는 사이트별 기능/UI/광고 차단 목적
!  일부 필터는 사이트 구조 변경 시 오작동 가능
!  "js"      : 사이트 스크립트 대응 (충돌 가능성 있음)
! 
! youtube_cleanfeed
! 
! youtube "menu ui" remove
youtube.com###menu
! youtube "comments" block 
youtube.com##ytd-comments
! youtube "ambient mode" disalbe
youtube.com###cinematics.ytd-watch-flexy
youtube.com###cinematics,#shorts-cinematic-container
! youtube "home mixeds" hide
youtube.com##ytd-rich-item-renderer:has([href*="start_radio=1"])
! youtube "sidebar mixes" hide
youtube.com##ytd-compact-radio-renderer, :is(#related yt-lockup-view-model,ytd-compact-video-renderer):has([href*="&start_radio=1"])
! youtube "channel watermark" disable
youtube.com##.ytp-watermark
youtube.com##.ytp-cards-teaser
youtube.com##.ytp-ce-channel
youtube.com##.iv-branding
! 
! fmkorea_cleanfeed
! 
! fmkorea "lightweight script trim"
||fmkorea.com/*analytics*.js$script
||fmkorea.com/*tracker*.js$script
! fmkorea "night mode" force enable [FIXED: AdGuard scriptlet syntax]
fmkorea.com#%#//scriptlet('set-cookie-reload', 'night_mode', 'Y')
! fmkorea "recent visited UI" remove
fmkorea.com##.fm-recent-visited
! fmkorea "recent searches UI" remove
fmkorea.com##.recent_searches
! fmkorea "floating controls" remove
fmkorea.com##.m_no_533
fmkorea.com##.rd_nav
! fmkorea "post address copy UI" remove
fmkorea.com##.document_address
! fmkorea "share button UI" remove
fmkorea.com##.doc_sns
! fmkorea "report button" remove
fmkorea.com##.declare_normal
! fmkorea "attachment file list" remove
fmkorea.com##tbody:has(th:has-text(첨부파일))
! fmkorea "comments" block
fmkorea.com##div[id*="cmtPosition"]
||fmkorea.com/*resize_image*.js$script
! fmkorea "related hotdeal list" remove
fmkorea.com##.relevant_hotdeals
! fmkorea "affiliate product ads" remove
fmkorea.com##.relevant_products_from_ad
! fmkorea "top widget (today best / board popular)" remove
fmkorea.com##aside.content_widget
! fmkorea "homepage header" remove
fmkorea.com##.logo > p.about
fmkorea.com##.logged_info
fmkorea.com##header#header::before
fmkorea.com##header#header:style(margin-bottom: 0 !important;)
fmkorea.com##header#header > div.Wrapper:style(padding-top: 9px !important;)
! fmkorea "notice" remove
fmkorea.com##.fm_global_notice
fmkorea.com##tr.notice
